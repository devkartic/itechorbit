APP_NAME=iTechOrbit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itechorbit
DB_USERNAME=itechorbit
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=itechorbit_cache_
SESSION_DRIVER=file
SESSION_COOKIE=itechorbit_session
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=itechorbit_database_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/login/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/login/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/login/google/callback
SITE_OWNER_ID=1
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_THROW_ON_ERROR=false
# History encryption defaults on in production; production must use HTTPS.
# INERTIA_HISTORY_ENCRYPT=true
GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
GOOGLE_ADSENSE_ID=

# Bulk notice email pacing (dedicated database queue).
NOTICE_MAIL_PER_MINUTE=30
