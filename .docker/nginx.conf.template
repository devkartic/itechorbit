resolver 127.0.0.11 valid=10s ipv6=off;
client_max_body_size 128m;
# Only browser navigation receives themed HTML. Asset/API failures remain 404s.
map $http_accept $itechorbit_error_html {
    default 0;
    ~*text/html 1;
}
server {
    listen 80 default_server;
    server_name _;
    root /var/www/html/${DOCUMENT_ROOT};
    index index.php index.html;
    server_tokens off;
    error_page 404 = @laravel_not_found;
    # Keep protected requests blocked; render the error without PHP or assets.
    error_page 403 /errors/403.html;
    location = /errors/403.html {
        internal;
        if ($itechorbit_error_html = 0) { return 403; }
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /dev { deny all; }
    location ^~ /dev/ { deny all; }
    location ~ /\. { deny all; }
    location ~* \.(?:env|sql|bak|ini|log)$ { deny all; }
    location ~ ^/storage/.*\.php$ { deny all; }
    location /storage/ { alias /var/www/html/storage/app/public/; }
    location @laravel_not_found {
        if ($itechorbit_error_html = 0) { return 404; }
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/${DOCUMENT_ROOT}/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/${DOCUMENT_ROOT};
        fastcgi_param HTTPS ${FASTCGI_HTTPS};
        # Laravel sees the original URL and returns its own HTTP 404. Do not
        # intercept PHP errors, which would recursively call this fallback.
        fastcgi_intercept_errors off;
        set $php_backend php:9000;
        fastcgi_pass $php_backend;
    }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/${DOCUMENT_ROOT}$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html/${DOCUMENT_ROOT};
        fastcgi_param HTTPS ${FASTCGI_HTTPS};
        fastcgi_intercept_errors off;
        set $php_backend php:9000;
        fastcgi_pass $php_backend;
    }
}
server {
    listen 8080;
    location = /health { return 200 "ok\n"; }
}
