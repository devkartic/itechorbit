{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["resources/js/*"] }, "ignoreDeprecations": "6.0"
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts", "tests/browser/**/*.ts", "playwright.config.ts"]
}
